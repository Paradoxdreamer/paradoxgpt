# ======================
# ParadoxGPT Configuration
# ======================

# Bot identity
BOT_NAME=ParadoxGPT
OWNER_NUMBER=234xxxxxxxxxx   # Your WhatsApp number with country code (no +)

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Web dashboard
WEB_PORT=3000
WEB_HOST=0.0.0.0

# Optional: prefix for commands (default .)
COMMAND_PREFIX=.

# Session folder (do not share)
SESSION_DIR=./data/session
